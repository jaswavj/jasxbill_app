{
  "name": "billing",
  "homepage": "/",
  "version": "1.0.0",
  "description": "Retail Billing Application",
  "author": "Billing",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "vite build --mode electron && node electron/patch-nsis.cjs && electron-builder --win nsis --config.win.signAndEditExecutable=false"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@reduxjs/toolkit": "^2.1.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "axios": "^1.6.3",
    "bootstrap": "^5.3.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.9.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.21.1",
    "react-toastify": "^10.0.3",
    "recharts": "^2.15.4",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-thunk": "^3.1.0",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "in.jasxbill.desktop",
    "productName": "JASXBILL",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/**/*",
      "package.json",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "electron/desktop-config.json",
        "to": "desktop-config.json"
      }
    ],
    "extraFiles": [
      {
        "from": "electron/desktop-config.json",
        "to": "desktop-config.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/jasxbill.png",
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JASXBILL",
      "artifactName": "JASXBILL-Setup-${version}.exe"
    }
  }
}
